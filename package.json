{
  "name": "strings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "docker:build": "docker build -t strings-app .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.9",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.61.0",
    "next": "^14.2.35",
    "otplib": "^13.5.0",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.14.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "sharp": "^0.35.5",
    "typescript": "5.5.4"
  }
}
