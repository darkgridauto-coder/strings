generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  handle        String   @unique
  displayName   String
  email         String   @unique
  passwordHash  String
  role          String   @default("user")   // "user" | "admin"
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String   @default("")
  twoFactorBackupCodes String @default("[]")
  verifiedTier            String   @default("")
  staffRole              String   @default("")
  settings String @default("{}")
  suspended              Boolean  @default(false)
  suspendedReason        String   @default("")
  suspendedAt            DateTime?
  emailVerified          Boolean  @default(false)
  emailVerifyHash        String   @default("")
  emailVerifyExp         DateTime?
  emailVerifySentAt      DateTime?
  bio           String   @default("")
  avatar        String   @default("")
  cover         String   @default("")
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts         Post[]
  comments      Comment[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  blocksSent    Block[]        @relation("blocker")
  blocksRecv    Block[]        @relation("blocked")
  messagesSent  Message[]
  conversations Conversation[] @relation("participants")
  callsMade     Call[]         @relation("caller")
  callsRecv     Call[]         @relation("receiver")
  subscriptions Subscription[]
  verifications Verification[]
  likes         Like[]
  savedPosts    SavedPost[]
  notifications Notification[]
  statuses     Status[]
  statusViews  StatusView[]
  pushSubscriptions PushSubscription[]
  lastLoginAt       DateTime?
  lastLoginIp       String    @default("")
  profileViewCount  Int       @default(0)
  appeals           Appeal[]
  loginEvents       LoginEvent[]
  pollVotes         PollVote[]
  strikes                Strike[]
  supportTickets         SupportTicket[]   @relation("SupportTickets")
  privacyRequests        PrivacyRequest[]  @relation("PrivacyRequests")
  adminNotesJson         String   @default("[]")
  sessions              Session[]
  passwordResetHash     String    @default("")
  passwordResetExp      DateTime?
  passwordResetSentAt   DateTime?
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  media     String   @default("")
  createdAt DateTime @default(now())
  comments  Comment[]

  editedAt      DateTime?
  mediaUrls     String    @default("[]")
  repostOfId    String?
  repostOf      Post?     @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts       Post[]    @relation("PostReposts")
  quoteText     String    @default("")
  scheduledFor  DateTime?
  isDraft       Boolean   @default(false)
  pollId        String?   @unique
  poll          Poll?     @relation(fields: [pollId], references: [id])
  viewCount     Int       @default(0)
  reviewedAt     DateTime?
  reviewDecision String   @default("")
  reviewCats     String   @default("[]")
  hiddenAt       DateTime?
  @@index([authorId])
  @@index([createdAt])
  likes     Like[]
  savedBy   SavedPost[]
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  status      String   @default("accepted")   // "pending" | "accepted"
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, status])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Conversation {
  id           String    @id @default(cuid())
  status       String    @default("accepted")   // "pending" | "accepted"
  requesterId  String?
  participants User[]    @relation("participants")
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
  readReceipts   ReadReceipt[]
  groupName      String        @default("")
  groupAvatar    String        @default("")
  groupOwnerId   String        @default("")
  roles          ConversationRole[]
  isRequest  Boolean @default(false)
}

model Message {
  id             String       @id @default(cuid())
  body           String
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  reactions      String   @default("[]")
  mediaUrl       String   @default("")
  mediaKind      String   @default("")
  mediaDur       Int      @default(0)   // JSON array of emoji
  createdAt      DateTime     @default(now())

  editedAt        DateTime?
  deletedAt       DateTime?
  expiresAt       DateTime?
  forwardedFromId String?
  forwardedFrom   Message?  @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[] @relation("MessageForwards")
  readAt    DateTime?
  @@index([conversationId, createdAt])
}

model Call {
  id         String   @id @default(cuid())
  callerId   String
  caller     User     @relation("caller", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  type       String   // "audio" | "video"
  status     String   // "answered" | "missed" | "declined" | "failed"
  duration   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

model Verification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier        String   // "identity" | "professional" | "organisation"
  status      String   @default("pending") // "pending" | "verified" | "rejected"
  data        String   @default("{}")
  reason      String   @default("")
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  @@unique([userId, tier])
  @@index([status])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "pro" | "verify"
  plan      String   // "monthly" | "annual"
  status    String   @default("active") // "active" | "cancelled"
  startedAt DateTime @default(now())
  renewsAt  DateTime

  @@unique([userId, kind])
}


model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  collectionName String @default("Saved")
  @@unique([userId, postId])
  @@index([postId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}


model ReadReceipt {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
}


model ConversationRole {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  role           String       @default("member")

  @@unique([conversationId, userId])
  @@index([conversationId])
}


model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  status      String   @default("open")
  resolution  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  severity     String   @default("Medium")
  assigneeId   String?
  notesJson    String   @default("[]")
  @@index([status])
  attachments ReportAttachment[]
}

model AdminAction {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}


model Status {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String       @default("")
  bg        Int          @default(0)
  img       String       @default("")
  createdAt DateTime     @default(now())
  expiresAt DateTime
  views     StatusView[]

  @@index([userId, expiresAt])
  @@index([createdAt])
}

model StatusView {
  id        String   @id @default(cuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([statusId, viewerId])
  @@index([statusId])
  @@index([viewerId])
}


model ReportAttachment {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url        String
  name       String   @default("")
  mimeType   String   @default("")
  size       Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([reportId])
}


model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}


model Announcement {
  id            String   @id @default(cuid())
  title         String
  message       String
  kind          String   @default("announcement")
  publishedById String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model PlatformSetting {
  key   String @id
  value String
}


model Poll {
  id        String       @id @default(cuid())
  question  String
  closesAt  DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  post      Post?
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([optionId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String   @default("")
  ip        String   @default("")
  succeeded Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Appeal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  reason       String
  status       String    @default("pending")
  reviewerId   String?
  reviewerNote String    @default("")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
}

model ViewEvent {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  viewerId   String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}


model Strike {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedById  String
  points      Int      @default(1)
  category    String
  reason      String   @default("")
  postId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}


model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("SupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  category    String
  subject     String
  body        String
  status      String   @default("open")
  priority    String   @default("Normal")
  assigneeId  String?
  reply       String   @default("")
  notesJson   String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([userId])
}


model Incident {
  id          String   @id @default(cuid())
  title       String
  severity    String   @default("SEV3")
  status      String   @default("Investigating")
  updatesJson String   @default("[]")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}


model PrivacyRequest {
  id               String   @id @default(cuid())
  type             String
  userId           String
  user             User     @relation("PrivacyRequests", fields: [userId], references: [id], onDelete: Cascade)
  identityVerified Boolean  @default(false)
  dueAt            DateTime
  status           String   @default("Received")
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([userId])
}


model AdminLogin {
  id        String   @id @default(cuid())
  userId    String
  email     String
  ok        Boolean
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}


model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}
