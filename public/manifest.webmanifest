{
  "name": "Strings",
  "short_name": "Strings",
  "description": "Connect in transparency... black and white.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Home feed", "short_name": "Home", "url": "/app", "icons": [{ "src": "/icons/shortcut.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/app/messages", "icons": [{ "src": "/icons/shortcut.png", "sizes": "192x192" }] },
    { "name": "New post", "short_name": "Compose", "url": "/app/posts/new", "icons": [{ "src": "/icons/shortcut.png", "sizes": "192x192" }] }
  ]
}
